---
# 실제 파일명은 rds_operation.yml로 복사한다. Secret은 저장하지 않는다.

rds_operation_aws_region: "ap-northeast-2"
rds_operation_endpoint: ""               # Terraform output rds_endpoint
rds_operation_port: 3306
rds_operation_master_secret_arn: ""      # Terraform output master_user_secret_arn

rds_operation_database: "infraready"
rds_operation_database_collation: "utf8mb4_uca1400_ai_ci"
rds_operation_seed_sql_gz: "/home/junghyun/infraready-latest.sql.gz"

# RDS를 Source로 할 때 On-Prem이 접속하는 최소 권한 계정
rds_operation_outbound_repl_username: "rds_to_onprem"
rds_operation_outbound_repl_password: "" # Ansible Vault 또는 -e 전용
rds_operation_outbound_repl_hosts:
  - "192.168.44.51"
  - "192.168.44.52"
rds_operation_binlog_retention_hours: 168
rds_operation_replication_use_ssl: false

# 초기 이관 중 On-Prem Source 계정. RDS private DB subnet만 허용한다.
rds_operation_inbound_source_host: "192.168.44.51"
rds_operation_inbound_source_port: 3306
rds_operation_inbound_repl_username: "onprem_to_rds"
rds_operation_inbound_repl_password: ""  # Ansible Vault 또는 -e 전용
rds_operation_inbound_repl_hosts:
  - "10.20.100.%"
  - "10.20.101.%"
rds_operation_inbound_gtid_position: ""  # dump 시점과 일치하는 GTID만 입력

rds_operation_socket: "/var/lib/mysql/mysql.sock"

# 안전장치 기본값
rds_operation_execute_mutations: false
rds_operation_allow_reset_replica: false
rds_operation_application_writes_fenced: false
rds_operation_cutover_approved: false
rds_operation_dr_writes_fenced: false
rds_operation_dr_promotion_approved: false
rds_operation_dr_promoted_inventory_hostname: ""
