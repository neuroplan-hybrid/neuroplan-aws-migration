---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ rosa_gitops_namespace }}

---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ rosa_gitops_target_namespace }}
  labels:
    argocd.argoproj.io/managed-by: {{ rosa_gitops_namespace }}

---
apiVersion: argoproj.io/v1beta1
kind: ArgoCD
metadata:
  name: {{ rosa_gitops_instance_name }}
  namespace: {{ rosa_gitops_namespace }}
spec:
  server:
    route:
      enabled: true
